# Banco (Aurora DSQL) e chave de credenciais: os mesmos do back (copie de back/.env).
DSQL_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# DSQL_REGION=                 # deduzida do endpoint
# DSQL_USER=admin
EVO_CRED_KEY=

# Usuário do tracker cujas credenciais EVO (com 2FA) o robô usa.
EVO_CHECKER_USER_EMAIL=lrsperanza@gmail.com

# Opcionais
# EVO_DEFAULT_UNIT=            # unidade para academias sem evo_unit_name
# EVO_CHROME_PATH=             # Chrome/Chromium; no Windows é achado sozinho
# EVO_HEADLESS=true
# EVO_TIMEOUT_MS=90000
# PAYMENT_PENDING_MAX_DAYS=30  # depois disso, pendente vira NAO_PAGO
# PAYMENT_LOOKBACK_DAYS=20     # aceita venda no EVO até N dias antes do lançamento (renovação lançada depois)
# PAYMENT_FORWARD_DAYS=7       # ... e até N dias depois (pagamento atrasado)
# GYM_TIMEZONE=America/Sao_Paulo
