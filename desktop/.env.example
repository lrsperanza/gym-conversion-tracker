# Usado por publish.ps1 ao enviar o build para o Azure Blob Storage.
# Estes valores sobrescrevem variáveis de mesmo nome já definidas no sistema.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# Opcionais (defaults em back/src/config/env.ts)
# DESKTOP_BLOB_CONTAINER=personal
# DESKTOP_BUILD_PREFIX=Skyfit-EVO-
