{
  "name": "intelbras-video-extractor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CLI that extracts an exact recorded-video interval from an Intelbras DVR/NVR via RTSP playback + FFmpeg remux.",
  "scripts": {
    "start": "bun run src/index.ts",
    "help": "bun run src/index.ts --help",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --target=bun-windows-x64-baseline src/index.ts --outfile dist/intelbras-video-extractor.exe"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
